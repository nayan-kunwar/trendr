{
  "name": "trendr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit --passWithNoTests",
    "test:coverage": "vitest run --project unit --passWithNoTests --coverage",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:contract": "vitest run --project contract",
    "db:generate": "pnpm --filter @trendr/db db:generate",
    "db:migrate": "pnpm --filter @trendr/db db:migrate",
    "db:seed": "pnpm --filter @trendr/db db:seed",
    "fixtures:record": "pnpm --filter @trendr/sources fixtures:record",
    "ingest:bootstrap": "pnpm --filter @trendr/worker ingest:bootstrap",
    "worker:score": "pnpm --filter @trendr/worker worker:score",
    "obs:smoke": "node scripts/obs-smoke.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "globals": "^17",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "testcontainers": "^12.2.1",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
