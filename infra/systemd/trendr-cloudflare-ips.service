[Unit]
Description=Refresh Cloudflare edge ranges for Trendr ingress
Documentation=file:/opt/trendr/docs/runbook.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/trendr
ExecStart=/bin/bash /opt/trendr/infra/scripts/refresh-cloudflare-ips.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5min
