{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@trendr/config": ["./packages/config/src/index.ts"],
      "@trendr/core": ["./packages/core/src/index.ts"],
      "@trendr/db": ["./packages/db/src/index.ts"],
      "@trendr/db/migrate": ["./packages/db/src/migrate.ts"],
      "@trendr/logger": ["./packages/logger/src/index.ts"],
      "@trendr/sources": ["./packages/sources/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
