{
  "name": "@trendr/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts src/score-cli.ts src/maintenance-cli.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker:score": "node dist/score-cli.js",
    "maintenance": "node dist/maintenance-cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@trendr/config": "workspace:*",
    "@trendr/core": "workspace:*",
    "@trendr/db": "workspace:*",
    "@trendr/email": "workspace:*",
    "@trendr/logger": "workspace:*",
    "@trendr/sources": "workspace:*",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6",
    "prom-client": "^15",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "eslint": "^9",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
