{
  "name": "@trendr/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "trendr-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
