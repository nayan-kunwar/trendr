    "@trendr/logger": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^10",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
