# Production environment template for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   # fill every value, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# Never commit .env.production. Generate secrets with:
#   openssl rand -hex 24   # POSTGRES_PASSWORD (URL-safe)
#   openssl rand -base64 48
#
# DATABASE_URL, REDIS_URL, CORS_ORIGINS, TRUST_PROXY and NODE_ENV are set by the
# compose file itself; do not duplicate them here.

LOG_LEVEL=info
DATABASE_POOL_MAX=10

# ── Public endpoints ─────────────────────────────────
# Both must be the same HTTPS origin served by nginx/Cloudflare. The web image
# is built with API_PUBLIC_URL via the `API_PUBLIC_URL` repository variable in
# the publish workflow, so keep the two values identical.
# M-12: this stack runs behind nginx, which overwrites CF-Connecting-IP.
TRUST_CF_CONNECTING_IP=true
# Exactly one trusted proxy hop (nginx). Prevents a caller-supplied
# X-Forwarded-For prefix from becoming the rate-limit/audit identity.
TRUST_PROXY_HOPS=1

API_PUBLIC_URL=https://trendr.example.com
WEB_PUBLIC_URL=https://trendr.example.com
# Same-origin VPS: keep lax. Use none only for split origins over HTTPS, where
# the browser would otherwise treat the refresh cookie as cross-site.
COOKIE_SAME_SITE=lax

# ── Authentication secrets (min 32 chars) ────────────
JWT_SECRET=
API_KEY_PEPPER=
UNSUBSCRIBE_SECRET=
ADMIN_EMAILS=you@example.com

# ── Metrics ──────────────────────────────────────────
# Bearer token for GET /metrics; also rendered into Prometheus config when the
# observability profile is used.
METRICS_TOKEN=

# ── Upstream credentials (worker) ────────────────────
# Fine-grained PAT, public repositories read-only. Required when the worker
# roles include ingest and NODE_ENV=production.
GITHUB_TOKENS=
GITHUB_RESERVE=200
HF_TOKEN=

# ── Email ────────────────────────────────────────────
# resend is recommended for a VPS; smtp requires reachable SMTP_URL.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Trendr <digest@example.com>
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── Worker ───────────────────────────────────────────
WORKER_ROLES=scheduler,ingest,scoring,notify
WORKER_CONCURRENCY_INGEST=4
SCHEDULER_ENABLED=true

# ── MCP ──────────────────────────────────────────────
# Comma-separated bearer tokens for /mcp. Required in production.
MCP_HTTP_AUTH_TOKENS=
# Read-only Trendr API key used by the MCP server to call the API.
MCP_API_KEY=

# ── Image source (compose interpolation) ─────────────
# GHCR owner defaults to nayan-kunwar; override for a fork.
GHCR_OWNER=nayan-kunwar
# Pin a published release tag, e.g. v1.0.0. `latest` is published for version
# tags only; workflow_dispatch builds publish `edge` and sha tags.
TRENDR_TAG=latest

# ── Backups (read by infra/scripts/backup.sh) ────────
BACKUP_DIR=/opt/trendr/backups
BACKUP_RETENTION_DAYS=30
# Optional: aws s3 cp destination. The script uploads with SSE-AES256.
# S3_URI=s3://my-bucket/trendr
# Optional: age recipient for client-side encryption before upload.
# BACKUP_AGE_RECIPIENT=age1...
