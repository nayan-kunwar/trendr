{
  "name": "@trendr/sources",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trendr/core": "workspace:*",
    "@trendr/logger": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9",
    "ioredis": "^5.11.1",
    "tsup": "^8",
    "typescript": "^5"
  }
}
