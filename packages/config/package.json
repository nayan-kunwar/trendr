{
  "name": "@trendr/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/mcp.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts src/mcp.ts --format esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^10",
    "tsup": "^8",
    "typescript": "^6"
  }
}
