{
  "name": "@trendr/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "^10.3.1",
    "resend": "^6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8",
    "eslint": "^10",
    "tsup": "^8",
    "typescript": "^5"
  }
}
