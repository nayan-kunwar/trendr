{
  "name": "@trendr/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pino": "^10",
    "pino-pretty": "^13"
  },
  "devDependencies": {
    "@types/node": "^26",
    "eslint": "^10",
    "tsup": "^9",
    "typescript": "^7"
  }
}
