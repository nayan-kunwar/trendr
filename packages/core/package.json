{
  "name": "@trendr/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && node scripts/copy-assets.mjs",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^10",
    "ioredis": "^6.0.0",
    "tsup": "^9",
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
